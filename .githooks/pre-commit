#!/usr/bin/env bash
# Scan des secrets sur les changements stagés avant chaque commit.
# Voir README.md pour l'installation de gitleaks.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-commit] gitleaks n'est pas installé : le scan de secrets est ignoré pour ce commit." >&2
    echo "[pre-commit] Installer gitleaks : https://github.com/gitleaks/gitleaks#installing" >&2
    echo "[pre-commit] Un scan gitleaks reste exécuté en CI et bloquera le merge en cas de fuite." >&2
    exit 0
fi

gitleaks git --pre-commit --redact --staged --verbose
