.git
.github
.idea
.vscode
var/cache/*
!var/cache/.gitkeep
var/log/*
!var/log/.gitkeep
vendor/
node_modules/
# .env (sans suffixe) contient des secrets réels en local (jamais committé, cf.
# .gitignore) - sans cette exclusion, "COPY . ." le copierait dans une couche
# d'image Docker ; écraser /app/.env plus tard dans le même stage (cp .env.dist
# .env) ne suffit pas à l'effacer de l'historique des couches, qui reste
# inspectable (docker history, extraction de couche) même dans l'image finale.
.env
.env.local
.env.*.local
.env.dev
.env.test
public/uploads/*
!public/uploads/.gitkeep
tests/
# Meme raisonnement que .env ci-dessus : config/jwt/*.pem est gitignore (jamais
# committe) mais peut tres bien exister physiquement sur la machine qui lance
# "docker build" (genere localement par le stage "dev") - sans cette exclusion,
# "COPY . ." dans le stage "build" embarquerait une vraie cle privee dans une
# couche de l'image finale, silencieusement et independamment de toute
# generation explicite dans le Dockerfile (audit Backend-Qualite #9, Phase 6).
config/jwt/*.pem
