###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=changeme
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://postgres:changeme@127.0.0.1:5432/bagage_express?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# En développement : autoriser localhost sur tous les ports
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|192\.168\.[0-9]+\.[0-9]+)(:[0-9]+)?$'
# En production : mettre votre domaine exact
# CORS_ALLOW_ORIGIN='https://votre-domaine.com'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme
# Durée de vie du token en secondes (3600 = 1h, 86400 = 24h)
JWT_TTL=86400
###< lexik/jwt-authentication-bundle ###

###> JWT Cookie Configuration ###
# Nom du cookie qui contiendra le JWT
JWT_COOKIE_NAME=bagage_token

# Sécurité du cookie
# false en dev (HTTP), true en prod (HTTPS obligatoire)
JWT_COOKIE_SECURE=true

# HttpOnly empêche JavaScript d'accéder au cookie (protection XSS)
JWT_COOKIE_HTTPONLY=true

# SameSite : 'lax' (recommandé, frontend et backend same-origin en cible),
# 'strict', ou 'none' (uniquement si frontend et backend sont sur des
# domaines réellement distincts).
JWT_COOKIE_SAMESITE=lax

# Domaine du cookie
# localhost en dev, votre-domaine.com en prod
JWT_COOKIE_DOMAIN=localhost
###< JWT Cookie Configuration ###

###> Application ###
FRONTEND_URL=http://localhost:3000
UPLOADS_DIR=uploads/avatars
MAX_FILE_SIZE=5242880
###< Application ###

###> OAuth Google ###
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
###< OAuth Google ###

###> OAuth Facebook ###
FACEBOOK_APP_ID=changeme
FACEBOOK_APP_SECRET=changeme
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback
###< OAuth Facebook ###

###> Twilio SMS Service ###
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
TWILIO_PHONE_NUMBER=+10000000000
###< Twilio SMS Service ###

###> Currency Configuration ###
DEFAULT_CURRENCY=EUR
EXCHANGE_RATE_API_KEY=changeme
###< Currency Configuration ###

###> Stripe (abonnements carte - Lot 1 monetisation) ###
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# Stopgap tant que le CRUD admin du catalogue (Lot 5) n'existe pas : Price Stripe
# (mode recurring) a creer manuellement dans le Dashboard Stripe pour les plans payants.
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=
###< Stripe (abonnements carte - Lot 1 monetisation) ###

SMS_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

###> Observabilité (Phase D1) ###
# Jeton de scrape Prometheus (GET /api/metrics) - aligné avec
# secrets/metrics_scrape_token_cobage côté infrastructure partagée en production.
METRICS_SCRAPE_TOKEN=changeme
# Endpoint OTLP HTTP du collecteur Tempo (infrastructure partagée du VPS en production).
TEMPO_OTLP_ENDPOINT=http://localhost:4318
###< Observabilité (Phase D1) ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_SUBSCRIBER_JWT_KEY="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

APP_BASE_DOMAIN=http://localhost:8000

# Durée de vie du Refresh Token en secondes (30 * 24 * 60 * 60 = 2592000)
REFRESH_TOKEN_TTL=2592000
